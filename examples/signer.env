# OpenStack credentials of the signer's own service user (standard openrc
# variables), injected by the platform's secret mechanism: never in the
# configuration file or the image. OS_AUTH_URL must be https.
OS_AUTH_URL=https://keystone.internal:5000/v3
OS_USERNAME=spire-metadata
OS_PASSWORD=CHANGE_ME
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_NAME=service
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=RegionOne
OS_INTERFACE=internal
# alternatively, an application credential (no project variables needed):
# OS_APPLICATION_CREDENTIAL_ID=...
# OS_APPLICATION_CREDENTIAL_SECRET=...
