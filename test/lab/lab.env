# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of the openstack-spiffe lab (see .specs/openstack-spire-test-environment.md).
#
# Every setting has its default here. To change one for a single machine, set
# it in lab.local.env next to this file (git-ignored); to change it for one
# command, set it in the environment. The environment wins over lab.local.env,
# which wins over this file.

# --- Versions -----------------------------------------------------------------

# Ubuntu release of devstack, issuer-a, spire and the Ubuntu guest image.
LAB_UBUNTU_RELEASE="24.04"
# RHEL-like distro of issuer-b and the second guest image: alma or rocky.
LAB_RHEL_DISTRO="alma"
# Its major release. Release 10 needs an x86-64-v3 CPU on the lab host.
LAB_RHEL_RELEASE="10"
# DevStack branch; empty: the most recent stable/* branch, resolved at "up".
LAB_DEVSTACK_BRANCH=""
# SPIRE release (e.g. "1.15.3") and the SHA-256 of its linux-amd64 tarball;
# empty: the most recent release compatible with the plugin SDK in go.mod,
# resolved at "up". A pinned version needs its SHA-256.
LAB_SPIRE_VERSION=""
LAB_SPIRE_SHA256=""
# Cloud image URLs; empty: derived from the distro and release. Set them to
# use a mirror.
LAB_UBUNTU_IMAGE_URL=""
LAB_RHEL_IMAGE_URL=""

# --- Network ------------------------------------------------------------------

# libvirt NAT network of the lab, and its IPv4 subnet (a /24).
LAB_NETWORK="spiffe-lab"
LAB_SUBNET="10.250.0.0/24"
# Host part of each address in LAB_SUBNET; the lab host is .1.
LAB_DEVSTACK_HOST="10"
LAB_ISSUER_A_HOST="21"
LAB_ISSUER_B_HOST="22"
LAB_SPIRE_HOST="30"

# --- Sizes --------------------------------------------------------------------

# vCPUs, RAM (GiB) and disk (GiB) of each VM.
LAB_DEVSTACK_VCPUS="8"
LAB_DEVSTACK_RAM_GIB="24"
LAB_DEVSTACK_DISK_GIB="100"
LAB_ISSUER_VCPUS="2"
LAB_ISSUER_RAM_GIB="2"
LAB_ISSUER_DISK_GIB="20"
LAB_SPIRE_VCPUS="2"
LAB_SPIRE_RAM_GIB="2"
LAB_SPIRE_DISK_GIB="20"

# --- Locations ----------------------------------------------------------------

# Lab state: PKI, SSH key, env.json. Relative paths are relative to this
# directory. Removed by "down".
LAB_STATE_DIR=".state"
# Downloaded images and tarballs, kept across "down".
LAB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/openstack-spiffe-lab"
# Tools the lab installs without root (e.g. goreleaser).
LAB_TOOLS_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/openstack-spiffe-lab/tools"
# libvirt storage pool of the VM disks, and its directory.
LAB_POOL="spiffe-lab"
LAB_POOL_DIR="/var/lib/libvirt/images/spiffe-lab"

# --- Behaviour ----------------------------------------------------------------

# Non-empty: answer yes to the preflight's installation prompt.
LAB_ASSUME_YES=""
